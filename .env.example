# Postgres connection string. On Vercel this is provided by the Prisma Postgres
# integration. Locally: docker run -d --name tml-postgres -e POSTGRES_PASSWORD=postgres -p 5434:5432 postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/thirdmilelabs"

# Admin portal password (used at /admin/login)
ADMIN_PASSWORD="change-me"

# Random 32+ char secret for signing admin sessions: `openssl rand -base64 48`
AUTH_SECRET=""

# Public site URL (used for SEO / Open Graph)
SITE_URL="https://thirdmilelabs.com"
